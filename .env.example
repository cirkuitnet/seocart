# The WordPress site the Playwright end-to-end suite (npm run test:e2e) runs against.
#
# Copy this file to .env (gitignored) and fill it in, or export the variables in your shell;
# the shell wins over the file. There are no defaults: the suite refuses to run without all
# three. Never commit real values.
#
# bin/dev/provision-site.sh writes these three lines for a disposable instance to
# ~/.seocart-dev/instances/<slug>.env on the dev server (mode 600, outside the web root).
# Instead of copying them, you can point SEOCART_E2E_ENV_FILE (a shell variable, not a line
# in this file) at that file as your workstation sees it.

# Home URL of the site, for example the URL of a disposable per-worktree instance.
WP_BASE_URL=
# An administrator on that site.
WP_USERNAME=
WP_PASSWORD=

# Optional. Set to 1 to accept a development TLS certificate this workstation does not trust.
# SEOCART_E2E_IGNORE_HTTPS_ERRORS=1
