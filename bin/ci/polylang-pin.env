# The one place that states which Polylang (free) version this project tests against.
#
# bin/ci/download-polylang.sh and bin/dev/provision-site.sh --with-polylang both read this
# file, so a CI cell and a developer's disposable site install the same version. Only the
# download-polylang.sh path verifies the download's checksum.
#
# To move to a newer release: change POLYLANG_VERSION, download
# https://downloads.wordpress.org/plugin/polylang.<version>.zip yourself, compute its
# SHA-256 and replace POLYLANG_SHA256 with it. Nothing else in the repository names either
# value.

POLYLANG_VERSION=3.8.9
POLYLANG_SHA256=de5fae3d399e34c2db496a02b7cff4e4ca79723c418c8542b82bb7c030204a60
