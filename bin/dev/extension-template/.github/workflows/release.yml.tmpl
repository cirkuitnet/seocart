# Release: a pushed tag vX.Y.Z becomes a GitHub Release with the zip, its checksum and an
# attestation of its build provenance, through SEOCart's reusable release workflow at the
# commit seocart-core.env pins. It does not deploy to WordPress.org.

name: Release

on:
    push:
        tags:
            - 'v[0-9]+.[0-9]+.[0-9]+'

permissions:
    contents: read

# Two runs for one tag must never race to create the same release.
concurrency:
    group: ${{ github.workflow }}-${{ github.ref }}
    cancel-in-progress: false

jobs:
    release:
        uses: cirkuitnet/seocart/.github/workflows/extension-release.yml@{{core_ref}}
        # The most the release needs. Each of its jobs asks for less, and only its publish job writes.
        permissions:
            actions: read
            attestations: write
            contents: write
            id-token: write
