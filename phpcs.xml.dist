<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="SEOCart project" xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">
	<description>WordPress Coding Standards, PHP compatibility and the SEOCart standard (tools/phpcs/SEOCart), for the whole repository.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/vendor-scoped/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<exclude-pattern>/artifacts/*</exclude-pattern>
	<exclude-pattern>/spikes/*</exclude-pattern>
	<!-- Sniff fixtures are violations on purpose; the sniff self-tests scan them explicitly. -->
	<exclude-pattern>/tools/phpcs/SEOCart/Tests/Fixtures/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg value="sp"/>

	<!--
		The rules themselves, shared with every SEOCart extension: the supported floors, the
		WordPress Coding Standards with this code base's exclusions, PHP compatibility and the
		SEOCart standard. What follows it is what belongs to this plugin alone: its text domain
		and its prefixes.
	-->
	<rule ref="./tools/phpcs/seocart-project.xml"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="seocart"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="seocart"/>
				<element value="SEOCart"/>
			</property>
		</properties>
	</rule>
</ruleset>
