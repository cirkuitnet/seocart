# PHPStan starts at level 5 with NO baseline. A baseline file may exist only to
# grandfather issues at the moment the level is raised, and may only shrink.
# The WordPress extension and stubs are loaded by phpstan/extension-installer.
parameters:
	level: 5
	paths:
		- seocart.php
		- uninstall.php
		- src
		- bin
		- tools
		- tests
	excludePaths:
		analyseAndScan:
			- tools/phpcs/SEOCart/Tests/Fixtures/*
	# Two libraries ship without Composer autoloading, so PHPStan is told where their
	# symbols live. They are scanned for discovery only, never analysed:
	# - PHP_CodeSniffer (classes and token constants), used by tools/phpcs/;
	# - the WordPress test library (WP_UnitTestCase, tests_add_filter), used by
	#   tests/Integration/ and tests/bootstrap-integration.php.
	scanDirectories:
		- vendor/squizlabs/php_codesniffer/src
		- vendor/wp-phpunit/wp-phpunit/includes
