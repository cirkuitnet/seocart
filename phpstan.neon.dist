# The level, the no-baseline rule, the WP-CLI symbols and the WordPress test library are shared
# with every SEOCart extension, so they are stated once, in tools/phpstan/shared.neon. This file
# says what SEOCart itself analyses.
includes:
	- tools/phpstan/shared.neon
parameters:
	paths:
		- seocart.php
		- uninstall.php
		- src
		- bin
		- tools
		- tests
	excludePaths:
		analyseAndScan:
			- tools/phpcs/SEOCart/Tests/Fixtures/*
			# A `wp eval-file` script for disposable sites. It calls WP-CLI and Polylang, and
			# neither can be discovered: Polylang is not a dependency, and the WP-CLI stubs
			# conflict with the WordPress 7.1 stubs. It is linted and sniffed like any other file.
			- bin/dev/polylang-languages.php
	# Two more libraries ship without Composer autoloading, so PHPStan is told where their
	# symbols live. They are scanned for discovery only, never analysed:
	# - PHP_CodeSniffer (classes and token constants), used by tools/phpcs/;
	# - the bundled Action Scheduler (its functions and classes), used by src/Platform/Jobs/.
	scanDirectories:
		- vendor/squizlabs/php_codesniffer/src
		- vendor-scoped/woocommerce/action-scheduler
