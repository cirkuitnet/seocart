# https://editorconfig.org — mirrors the WordPress coding standards.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# Four spaces, as @wordpress/prettier-config formats YAML: `prettier --check .` is the gate.
[*.{yml,yaml}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

[{*.txt,LICENSE}]
trim_trailing_whitespace = false
indent_style = space
