{
    "openapi": "3.1.0",
    "info": {
        "title": "SEOCart REST API",
        "version": "v1",
        "description": "The routes of the `seocart/v1` namespace. Each operation is generated from the same declaration as its ability and its WP-CLI command, which docs/reference/ describes. A request authenticates as a WordPress user, with a REST nonce or an application password, and each operation names the capability it requires.",
        "license": {
            "name": "GPL-3.0-or-later",
            "identifier": "GPL-3.0-or-later"
        }
    },
    "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/base",
    "servers": [
        {
            "url": "{site}/wp-json/seocart/v1",
            "variables": {
                "site": {
                    "default": "https://example.com",
                    "description": "The address of the WordPress site."
                }
            }
        }
    ],
    "paths": {
        "/settings": {
            "get": {
                "operationId": "settings.get_settings",
                "summary": "Returns every store setting, with its saved value or, when it was never saved, its default.",
                "description": "Requires the capability `seocart_manage_settings`.",
                "responses": {
                    "200": {
                        "description": "The operation succeeded. The body is the Settings resource.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Settings"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The request does not match the input schema: `rest_invalid_param` or `rest_missing_callback_param`.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No user is logged in, and the operation requires the capability `seocart_manage_settings`: `rest_forbidden`.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "The user does not hold the capability `seocart_manage_settings`: `rest_forbidden`.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "`settings.stored_value_invalid`: The option {option} holds a value SEOCart cannot use. Save the setting again to replace it.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            },
            "patch": {
                "operationId": "settings.update_settings",
                "summary": "Changes the store settings the request names, checking every value before saving any, and returns every store setting.",
                "description": "Requires the capability `seocart_manage_settings`.",
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "base_currency": {
                                        "type": "string",
                                        "description": "ISO 4217 code of the currency the store keeps its accounts in, in upper case.",
                                        "examples": [
                                            "EUR"
                                        ]
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The operation succeeded. The body is the Settings resource.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Settings"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The request does not match the input schema: `rest_invalid_param` or `rest_missing_callback_param`.\n\n`currency.unknown`: {currency} is not a currency code that SEOCart supports.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No user is logged in, and the operation requires the capability `seocart_manage_settings`: `rest_forbidden`.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "The user does not hold the capability `seocart_manage_settings`: `rest_forbidden`.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "`settings.stored_value_invalid`: The option {option} holds a value SEOCart cannot use. Save the setting again to replace it.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "`store.unavailable`: The store is temporarily unavailable while its database is being updated ({reason}).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/stock-items/{variant_id}/adjustments": {
            "post": {
                "operationId": "inventory.adjust_stock",
                "summary": "Changes the units on hand of one variant by a signed amount, records the change in the stock ledger with its reason, and returns the stock level after it.",
                "description": "Requires the capability `seocart_manage_inventory`.",
                "parameters": [
                    {
                        "name": "variant_id",
                        "in": "path",
                        "required": true,
                        "description": "The id of the variant whose stock is adjusted.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "examples": [
                                42
                            ]
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "delta": {
                                        "type": "integer",
                                        "minimum": -1000000,
                                        "maximum": 1000000,
                                        "description": "The change of the units on hand: positive for units that arrived, negative for units that left; never 0.",
                                        "examples": [
                                            5
                                        ]
                                    },
                                    "reason": {
                                        "type": "string",
                                        "enum": [
                                            "received",
                                            "recount",
                                            "damaged",
                                            "returned",
                                            "correction"
                                        ],
                                        "description": "Why the units on hand changed.",
                                        "examples": [
                                            "received"
                                        ]
                                    },
                                    "expected_on_hand": {
                                        "type": "integer",
                                        "minimum": 0,
                                        "description": "The units on hand the client last read. When given, the change applies only while the variant still has exactly that many, so a repeated request cannot apply it twice.",
                                        "examples": [
                                            12
                                        ]
                                    }
                                },
                                "required": [
                                    "delta",
                                    "reason"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The operation succeeded. The body is the StockLevel resource.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/StockLevel"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The request does not match the input schema: `rest_invalid_param` or `rest_missing_callback_param`.\n\n`stock.zero_delta`: An adjustment of zero units changes nothing. To confirm a count, adjust by the difference you found.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No user is logged in, and the operation requires the capability `seocart_manage_inventory`: `rest_forbidden`.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "The user does not hold the capability `seocart_manage_inventory`: `rest_forbidden`.\n\n`authorization.denied`: Sorry, you are not allowed to do that. It requires the {capability} capability.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "`stock.item_missing`: Variant {variant_id} has no stock item.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "`stock.on_hand_conflict`: Variant {variant_id}: you expected {expected} on hand, but there are {on_hand}, so the adjustment was not applied. Read the stock again, then repeat the adjustment if it is still needed.\n\n`stock.adjustment_below_zero`: Variant {variant_id} has {on_hand} on hand, so a change of {delta} would take it below zero.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "`store.unavailable`: The store is temporarily unavailable while its database is being updated ({reason}).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Error": {
                "type": "object",
                "description": "An error. WordPress writes it as its code, its message and its data; the data members are the same for every error of these routes, including WordPress's own refusal of a request that does not match the input schema or of a user who lacks the capability, but not its refusal of a JSONP callback, which it sends before any route is matched.",
                "properties": {
                    "code": {
                        "type": "string",
                        "description": "The error code: one of those in docs/reference/errors.md, or a code of the WordPress REST API such as `rest_invalid_param` or `rest_forbidden`."
                    },
                    "message": {
                        "type": "string",
                        "description": "What went wrong, for people, in the language of the site. An internal error has a generic message."
                    },
                    "data": {
                        "type": "object",
                        "properties": {
                            "status": {
                                "type": "integer",
                                "description": "The HTTP status of the error."
                            },
                            "details": {
                                "type": "object",
                                "description": "The values the message was built from, keyed by name. For an error WordPress raised, such as its refusal of a request that does not match the input schema, every other member of its data under the name WordPress gave it, such as `params`; WordPress's own per-parameter `details` is flattened into `param_codes`, one code for each parameter WordPress gave a code, omitted when there is none, so nothing named `details` ever nests inside `details`. Always an object, and empty for an internal error."
                            },
                            "correlation_id": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "description": "The identifier of the request the error happened in, which the site's log records with the error; null when the request has none."
                            }
                        },
                        "required": [
                            "status",
                            "details",
                            "correlation_id"
                        ]
                    }
                },
                "required": [
                    "code",
                    "message",
                    "data"
                ]
            },
            "Settings": {
                "type": "object",
                "properties": {
                    "base_currency": {
                        "type": "string",
                        "description": "ISO 4217 code of the currency the store keeps its accounts in, in upper case.",
                        "examples": [
                            "EUR"
                        ]
                    }
                },
                "required": [
                    "base_currency"
                ]
            },
            "StockLevel": {
                "type": "object",
                "properties": {
                    "variant_id": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "The id of the variant whose stock is adjusted.",
                        "examples": [
                            42
                        ]
                    },
                    "on_hand": {
                        "type": "integer",
                        "description": "The units physically in stock after the change.",
                        "examples": [
                            17
                        ]
                    },
                    "allocated": {
                        "type": "integer",
                        "description": "The units promised to accepted orders.",
                        "examples": [
                            2
                        ]
                    },
                    "held": {
                        "type": "integer",
                        "description": "The units held by checkouts, expired holds included until they are reclaimed.",
                        "examples": [
                            3
                        ]
                    },
                    "available": {
                        "type": "integer",
                        "description": "The units that may still be promised: on hand, less allocated, less held. Negative when fewer units were counted than are promised or held.",
                        "examples": [
                            12
                        ]
                    },
                    "ledger_entry_id": {
                        "type": "integer",
                        "description": "The id of the stock ledger entry that records the change.",
                        "examples": [
                            381
                        ]
                    }
                },
                "required": [
                    "variant_id",
                    "on_hand",
                    "allocated",
                    "held",
                    "available",
                    "ledger_entry_id"
                ]
            }
        }
    }
}
